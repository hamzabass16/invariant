{
  "name": "portfolio-os",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:guard": "tsx scripts/check-guard.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:options": "tsx scripts/check-options.ts",
    "check:exposure": "tsx scripts/check-exposure.ts",
    "check:setup": "tsx scripts/check-setup.ts",
    "check:screens": "tsx scripts/check-screens.ts",
    "check:parity": "tsx scripts/check-parity.ts",
    "check:synthetic": "tsx scripts/check-synthetic.ts",
    "check:report": "tsx scripts/check-report.ts",
    "check:vault": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-vault.ts",
    "check:statements": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-statements.ts",
    "check:import": "tsx scripts/check-import.ts",
    "check:research": "tsx scripts/check-research.ts",
    "check:analyst": "tsx scripts/check-analyst.ts",
    "check:performance": "tsx scripts/check-performance.ts",
    "check:decisions": "tsx scripts/check-decisions.ts",
    "check:library": "tsx scripts/check-library.ts",
    "check:todo": "tsx scripts/check-todo.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check:markets": "tsx scripts/check-markets.ts",
    "check:earnings": "tsx scripts/check-earnings.ts",
    "check:theses": "tsx scripts/check-theses.ts",
    "check:community": "tsx scripts/check-community.ts",
    "check:agents": "tsx scripts/check-agents.ts",
    "check:model": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-model.ts",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "check:review-parity": "tsx scripts/check-review-parity.ts",
    "check:pdf": "esbuild scripts/check-pdf.mts --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=.next/check-pdf.mjs && node .next/check-pdf.mjs",
    "synth:loop": "tsx scripts/synth-loop.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.4.0",
    "langchain": "^1.5.16",
    "lucide-react": "^1.33.0",
    "mailparser": "^3.9.38",
    "marked": "^18.0.11",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "sharp": true
  }
}
