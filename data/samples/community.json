      "version": 1,
      "handle": "quiet-compounder",
      "name": "Ines",
      "about": "A fictional profile for the demo. Ten businesses with pricing power, held for years, trimmed only at a cap.",
      "methodology": "Compounders, with caps",
      "stocks": [
        {
          "symbol": "MA",
          "text": "A fictional thesis. A two-sided network that every participant pays to use; revenue follows nominal spending and the margin widens on a fixed cost base. What must stay true: volume growth above nominal GDP and no regulator capping the interchange it does not set.",
          "pathway": null,
          "pillars": [
            {
              "name": "Volume keeps growing",
              "text": "Revenue grows at least 10% a year.",
              "test": {
                "field": "revenue_growth_pct",
                "is": "gte",
                "value": 10
              }
            },
            {
              "name": "The margin holds",
              "text": "Operating margin at or above 55%.",
              "test": {
                "field": "operating_margin_pct",
                "is": "gte",
                "value": 55
