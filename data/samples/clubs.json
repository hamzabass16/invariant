      "pitches": [
        {
          "id": "msft-azure-margins-20260512150000",
          "symbol": "MSFT",
          "title": "Azure's margins are the case",
          "body": "Cloud revenue grows above 25% while the operating margin holds near 45%. The case rests on the AI capacity being sold before it is built; the risk is the capital spending running ahead of it.",
          "author": "Marcus L.",
          "createdAt": "2026-05-12T15:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 380,
            "base": 470,
            "bull": 560,
            "price": null
          },
          "you": false
        },
        {
          "id": "ma-toll-on-payments-20260618120000",
          "symbol": "MA",
          "title": "A toll on every card payment",
          "body": "Cross-border volume recovers and value-added services grow faster than payments. The network effect is the moat; regulation of interchange is the risk to watch.",
          "author": "Sofia R.",
          "createdAt": "2026-06-18T12:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 480,
            "base": 560,
            "bull": 640,
            "price": null
          },
          "you": false
        },
        {
          "id": "costpitchmembership-flywheel-20261020140000",
          "symbol": "COST",
          "title": "Membership flywheel",
          "body": "Renewal rates above 90% in the US and Canada make the fee income close to a bond coupon. The pitch: the warehouse count can grow by about 30 a year for a decade, and each new warehouse matures into the same fee base. Risk: the multiple already prices most of it.",
          "author": "Priya N.",
          "you": false,
          "createdAt": "2026-10-20T14:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 780,
            "base": 960,
            "bull": 1150,
            "price": null
          }
        },
        {
          "id": "tsm-advanced-nodes-20261027160000",
          "symbol": "TSM",
          "title": "Advanced nodes carry the margin",
          "body": "Three and five nanometre wafers are now more than half of revenue. The pitch: pricing power holds while no other foundry ships at volume on the newest node. What would break it: a second source qualifying at a major customer.",
          "author": "Demo visitor",
          "you": true,
          "createdAt": "2026-10-27T16:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 150,
            "base": 210,
            "bull": 260,
            "price": null
          }
        },
        {
          "id": "ko-pricing-over-volume-20261103120000",
          "symbol": "KO",
          "title": "Pricing over volume",
          "body": "Organic growth has come from price for eight quarters while unit cases are flat. The question for the committee: how long can price lead before volume falls?",
          "author": "Marcus L.",
          "you": false,
          "createdAt": "2026-11-03T12:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 58,
            "base": 68,
            "bull": 76,
            "price": null
          }
        },
        {
          "id": "tsm-geography-risk-20261104180000",
          "symbol": "TSM",
          "title": "The counter case: where the fabs are",
          "body": "Most leading-edge capacity sits in one place. The new fabs abroad cost more to run, which the pitch above does not price.",
          "author": "Sofia R.",
          "you": false,
          "createdAt": "2026-11-04T18:00:00.000Z",
          "bountyId": null,
          "valuation": {
            "bear": 150,
            "base": 210,
            "bull": 260,
            "price": null
          }
        },
        {
          "id": "nvo-glp1-price-20261106110000",
          "symbol": "NVO",
          "title": "The price cut is in the price",
          "body": "The October list-price cut takes about 4% off next year's revenue at the company's own volume guidance, and the stock fell 18% on the day. Volume growth in the guidance is 22%; the case fails if the next quarter's prescriptions grow under 15%.",
          "author": "Daniel K.",
          "you": false,
          "createdAt": "2026-11-06T11:00:00.000Z",
          "bountyId": "nvo-bounty-glp1-20261101090000",
          "valuation": {
            "bear": 55,
            "base": 80,
            "bull": 110,
            "price": null
          }
        },
        {
          "id": "nvo-not-yet-20261107150000",
          "symbol": "NVO",
          "title": "Not yet: volumes have to show it",
          "body": "The price cut is known; the volume that pays for it is not. Two quarters of prescriptions above guidance would make the case, and until then the club should wait.",
          "author": "Priya N.",
          "you": false,
          "createdAt": "2026-11-07T15:00:00.000Z",
          "bountyId": "nvo-bounty-glp1-20261101090000",
          "valuation": null
        }
      ],
