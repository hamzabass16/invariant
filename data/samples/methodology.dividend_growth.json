 "adopted": "2026-01-01",
 "source": {
  "title": "Sample dividend growth policy (fictional)",
  "fileId": null
 },
 "origin": "sample",
 "summary": "Own companies that raise their dividend every year and let the income compound. Judge the portfolio by what it pays and how fast that grows, not by its price; keep every position modest and a little cash on hand.",
 "figures": [
  {
   "id": "dividend-income-ttm",
   "label": "Dividend income, last twelve months",
   "about": "Dividends received in the last twelve months.",
   "unit": "money",
   "expr": {
    "op": "measure",
    "of": {
     "measure": "sum",
     "over": "transactions",
     "field": "amount",
     "where": [
      {
       "field": "kind",
       "is": "eq",
       "value": "dividend"
      }
     ],
     "window": {
      "kind": "ttm"
     }
    }
   },
   "view": "tile"
  },
  {
   "id": "dividend-growth",
   "label": "Dividend growth",
   "about": "Dividends in the last twelve months against the twelve before.",
   "unit": "pct",
   "expr": {
    "op": "growth",
    "now": {
     "measure": "sum",
     "over": "transactions",
     "field": "amount",
     "where": [
      {
       "field": "kind",
       "is": "eq",
       "value": "dividend"
      }
     ],
     "window": {
      "kind": "ttm"
     }
    },
    "before": {
     "measure": "sum",
     "over": "transactions",
     "field": "amount",
     "where": [
      {
       "field": "kind",
       "is": "eq",
       "value": "dividend"
      }
     ],
     "window": {
      "kind": "prior_ttm"
     }
    }
   },
   "view": "tile"
  },
  {
   "id": "yield-on-cost",
   "label": "Yield on cost",
   "about": "Dividends in the last twelve months over what the shares and funds cost.",
   "unit": "pct",
   "expr": {
    "op": "ratio",
    "num": {
     "measure": "sum",
     "over": "transactions",
     "field": "amount",
     "where": [
      {
       "field": "kind",
       "is": "eq",
       "value": "dividend"
      }
     ],
     "window": {
      "kind": "ttm"
     }
    },
    "den": {
     "measure": "sum",
     "over": "holdings",
     "field": "cost",
     "where": [
      {
       "field": "asset_class",
       "is": "in",
       "value": [
        "equity",
        "etf"
       ]
      }
     ]
    }
   },
   "view": "tile"
  },
  {
   "id": "net-worth",
   "label": "Net worth",
   "about": "Everything at the owner's share, real estate net of its mortgage.",
