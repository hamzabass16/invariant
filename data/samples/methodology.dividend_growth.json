 "rules": [
  {
   "id": "growth",
   "section": "1.1",
   "text": "Dividend income grows at least 5% a year.",
   "severity": "guideline",
   "test": {
    "figure": "dividend-growth",
    "is": "gte",
    "limit": 5
   }
  },
  {
   "id": "position-cap",
   "section": "1.2",
   "text": "No holding above 20% of the portfolio.",
   "severity": "breach",
   "test": {
    "figure": "weight-by-symbol",
    "is": "lte",
    "limit": 20
   }
  },
  {
   "id": "payout",
   "section": "2.1",
   "text": "Every holding's payout ratio stays under 60%.",
   "severity": "guideline",
   "test": {
    "figure": "payout-ratio",
    "is": "lte",
    "limit": 60
   }
  },
  {
   "id": "raises",
   "section": "2.2",
   "text": "Only companies with ten or more years of consecutive raises.",
   "severity": "guideline",
   "test": {
    "figure": "years-raised",
    "is": "gte",
    "limit": 10
   }
  },
  {
   "id": "cash-floor",
   "section": "3.1",
   "text": "Keep 5% in cash for the next purchase.",
   "severity": "guideline",
   "test": {
    "figure": "cash-share",
    "is": "gte",
    "limit": 5
   }
  },
  {
   "id": "reinvest",
   "section": "3.2",
   "text": "Reinvest dividends within the month they arrive.",
   "severity": "guideline",
   "test": null
  }
