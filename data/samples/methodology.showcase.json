{
 "name": "Quality compounders v3.4",
 "adopted": "2026-10-13",
 "summary": "The owner runs a concentrated, long-horizon equity portfolio in its accumulation phase. Holdings are sorted into archetypes by a Classification Test, which counts how many of seven Compounding Machine thresholds a holding passes and checks whether it has a disruption engine. Each archetype has its own position cap: Transitional Holdings 20%, Compounding Machines 10%, Disruptive Growth 5%, and Macro Plays 5% each with 10% in total. Market regime indicators affect only the pace of buying, not what is bought.",
 "figures": [
  {
   "id": "net-worth",
   "label": "Total portfolio",
   "about": "Everything at the owner's share.",
   "unit": "money",
   "expr": {
    "op": "measure",
    "of": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": []
    }
   },
   "view": "tile"
  },
  {
   "id": "weight-by-holding",
   "label": "Weight by holding",
   "about": "Each holding's share of the total portfolio.",
   "unit": "pct",
   "expr": {
    "op": "ratio",
    "num": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": [
      {
       "field": "asset_class",
       "is": "not_in",
       "value": [
        "cash",
        "deposit"
       ]
      }
     ]
    },
    "den": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": [],
     "whole": true
    }
   },
   "by": "symbol",
   "view": "table"
  },
  {
   "id": "weight-compounding",
   "label": "Compounding Machine weights",
   "about": "Each Compounding Machine's share of the total portfolio, against the 10% cap.",
