 ],
 "classes": [
  {
   "id": "transitional",
   "label": "Transitional Holding",
   "about": "Has a disruption engine and passes 57% or more of the measurable A.2 thresholds; 20% cap. At 71% or more it stays Transitional unless the IC records that D.1(b) cannot be met (W7/C2).",
   "required": [
    {
     "field": "engine_growth_pct",
     "is": "gt",
     "value": 20
    }
   ],
   "criteria": [
    {
     "field": "roic_pct",
     "is": "gte",
     "value": 20,
     "or": [
      {
       "field": "roic_ex_goodwill_pct",
       "is": "gte",
       "value": 20,
       "given": [
        {
         "field": "goodwill_share_of_capital_pct",
         "is": "gt",
         "value": 50
        }
       ]
      },
      {
       "field": "invested_capital",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "operating_margin_pct",
         "is": "gt",
         "value": 0
        }
       ]
      }
     ]
    },
    {
     "field": "gross_margin_pct",
     "is": "gte",
     "value": 40
    },
    {
     "field": "operating_margin_change_pts",
     "is": "gt",
     "value": 0
    },
    {
     "field": "fcf_conversion",
     "is": "gte",
     "value": 0.9,
     "given": [
      {
       "field": "loans_to_equity",
       "is": "lte",
       "value": 1
      },
      {
       "field": "nonoperating_share_of_net_income_pct",
       "is": "lte",
       "value": 20
      }
     ],
     "or": [
      {
       "field": "fcf_conversion_operating",
       "is": "gte",
       "value": 0.9,
       "given": [
        {
         "field": "loans_to_equity",
         "is": "lte",
         "value": 1
        },
        {
         "field": "nonoperating_share_of_net_income_pct",
         "is": "gt",
         "value": 20
        }
       ]
      }
     ]
    },
    {
     "field": "interest_cover",
     "is": "gt",
     "value": 15,
     "given": [
      {
       "field": "cash_to_debt_pct",
       "is": "lte",
       "value": 75
      }
     ],
     "or": [
      {
       "field": "interest_cover_net",
       "is": "gt",
       "value": 15,
       "given": [
        {
         "field": "cash_to_debt_pct",
         "is": "gt",
         "value": 75
        }
       ]
      },
      {
       "field": "net_interest_expense",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "cash_to_debt_pct",
         "is": "gt",
         "value": 75
        }
       ]
      }
     ]
    },
    {
     "field": "revenue_growth_pct",
     "is": "gt",
     "value": 0
    },
    {
     "field": "fcf_per_share_growth_pct",
     "is": "gt",
     "value": 0
    }
   ],
   "minimumShare": 57
  },
  {
   "id": "compounding",
   "label": "Compounding Machine",
   "about": "Passes 71% or more of the measurable A.2 thresholds and has no disruption engine; 10% cap. Sectors on the A.4 exclusion list are left out.",
   "required": [
    {
     "field": "engine_growth_pct",
     "is": "lte",
     "value": 20
    },
    {
     "field": "sector",
     "is": "not_in",
     "value": [
      "Energy",
      "Utilities"
     ]
    }
   ],
   "criteria": [
    {
     "field": "roic_pct",
     "is": "gte",
     "value": 20,
     "or": [
      {
       "field": "roic_ex_goodwill_pct",
       "is": "gte",
       "value": 20,
       "given": [
        {
         "field": "goodwill_share_of_capital_pct",
         "is": "gt",
         "value": 50
        }
       ]
      },
      {
       "field": "invested_capital",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "operating_margin_pct",
         "is": "gt",
         "value": 0
        }
       ]
      }
     ]
    },
    {
     "field": "gross_margin_pct",
     "is": "gte",
     "value": 40
    },
    {
     "field": "operating_margin_change_pts",
     "is": "gt",
     "value": 0
    },
    {
