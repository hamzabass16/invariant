   "expr": {
    "op": "ratio",
    "num": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": [
      {
       "field": "class",
       "is": "eq",
       "value": "compounding"
      }
     ]
    },
    "den": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": [],
     "whole": true
    }
   },
   "by": "symbol",
   "view": "table"
  },
  {
