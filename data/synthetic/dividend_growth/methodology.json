  "rules": [
    {
      "id": "income-growth",
      "section": "1.2",
      "text": "Income grows at least 7% a year.",
      "severity": "guideline",
      "test": {
        "figure": "income-growth",
        "is": "gte",
        "limit": 7
      }
    },
    {
      "id": "raises",
      "section": "2.1",
      "text": "Every company has raised its dividend for at least ten consecutive years.",
      "severity": "guideline",
      "test": {
        "figure": "years-raised",
        "is": "gte",
        "limit": 10
      }
    },
    {
      "id": "payout",
      "section": "2.2",
      "text": "Payout ratio at or below 60% of earnings.",
      "severity": "guideline",
      "test": {
        "figure": "payout-by-holding",
        "is": "lte",
        "limit": 60
      }
    },
    {
      "id": "dividend-growth",
      "section": "2.3",
      "text": "Dividend growth over five years of at least 6% a year.",
      "severity": "guideline",
      "test": {
        "figure": "dividend-growth-5y",
        "is": "gte",
        "limit": 6
      }
    },
    {
      "id": "position-cap",
      "section": "3.1",
      "text": "No holding above 12% of the portfolio.",
      "severity": "breach",
      "test": {
        "figure": "weight-by-holding",
        "is": "lte",
        "limit": 12
      }
    },
    {
      "id": "sector-cap",
      "section": "3.2",
      "text": "No sector above 25% of the portfolio.",
      "severity": "guideline",
      "test": {
        "figure": "weight-by-sector",
        "is": "lte",
        "limit": 25
      }
    },
    {
      "id": "min-holdings",
      "section": "3.3",
      "text": "At least twelve companies at all times.",
      "severity": "guideline",
      "test": {
        "figure": "holdings-count",
        "is": "gte",
        "limit": 12
      }
    },
    {
      "id": "cash-floor",
      "section": "4.1",
      "text": "Cash at least 3% of the portfolio.",
      "severity": "guideline",
      "test": {
        "figure": "cash-share",
        "is": "gte",
        "limit": 3
      }
    },
    {
      "id": "cash-cap",
      "section": "4.1",
      "text": "Cash at most 10% of the portfolio.",
      "severity": "guideline",
      "test": {
        "figure": "cash-share",
        "is": "lte",
        "limit": 10
      }
    },
    {
      "id": "reinvest",
      "section": "6.1",
      "text": "Every dividend is reinvested within the month it arrives.",
      "severity": "guideline",
      "test": null
    },
    {
      "id": "contribute",
      "section": "6.2",
      "text": "Add 2,000 dollars a month: 24,000 over twelve months.",
      "severity": "guideline",
      "test": {
        "figure": "contributions-ttm",
        "is": "gte",
        "limit": 24000
      }
    }
