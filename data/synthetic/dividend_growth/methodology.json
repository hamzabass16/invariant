{
  "name": "The Income Ledger",
  "adopted": "2026-01-01",
  "summary": "Around fifteen dividend payers at one broker, judged on the income they pay and its growth, never on price. Quality tests on payout and raises, a 12% cap per holding, cash kept between 3% and 10%.",
  "source": {
    "title": "The Income Ledger (fictional)",
    "fileId": null
  },
  "origin": "document",
  "figures": [
    {
      "id": "net-worth",
      "label": "Portfolio value",
      "about": "Everything in the account at today's marks.",
      "unit": "money",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value"
        }
      },
      "view": "tile"
    },
    {
      "id": "income-ttm",
      "label": "Dividends, 12 months",
      "about": "Dividends received over the last twelve months (1.1).",
      "unit": "money",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "dividend"
            }
          ],
          "field": "amount",
          "window": {
            "kind": "ttm"
          }
        }
      },
      "view": "tile"
    },
    {
      "id": "income-growth",
      "label": "Income growth",
      "about": "Dividends in the last twelve months against the twelve before (1.2).",
      "unit": "pct",
      "expr": {
        "op": "growth",
        "now": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "dividend"
            }
          ],
          "field": "amount",
          "window": {
            "kind": "ttm"
          }
        },
        "before": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "dividend"
            }
          ],
          "field": "amount",
          "window": {
            "kind": "prior_ttm"
          }
        }
      },
      "view": "tile"
    },
    {
      "id": "yield-on-cost",
      "label": "Yield on cost",
      "about": "Dividends over twelve months against what the payers cost (2.4).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "dividend"
            }
          ],
          "field": "amount",
          "window": {
            "kind": "ttm"
          }
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "in",
              "value": [
                "equity",
                "etf"
              ]
            }
          ],
          "field": "cost"
        }
      },
      "view": "tile"
    },
    {
      "id": "yield-on-cost-by-holding",
      "label": "Yield on cost by holding",
