      "expr": {
        "op": "measure",
        "of": {
          "measure": "avg",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "eq",
              "value": "private_fund"
            }
          ],
          "field": "fund_tvpi"
        }
      },
      "view": "table",
      "by": "holding"
