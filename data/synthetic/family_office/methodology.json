      "text": "Real estate at most 20% of net worth, at our share, net of mortgages.",
      "severity": "guideline",
      "test": {
        "figure": "real-estate-share",
        "is": "lte",
        "limit": 20
      }
    },
    {
      "id": "cash-floor",
      "section": "1.5",
      "text": "Cash at least 5% of net worth.",
      "severity": "guideline",
      "test": {
        "figure": "cash-share",
        "is": "gte",
        "limit": 5
      }
    },
    {
      "id": "liquidity",
      "section": "2.1",
      "text": "At least 40% of net worth liquid.",
      "severity": "breach",
      "test": {
        "figure": "liquid-share",
        "is": "gte",
        "limit": 40
      }
    },
    {
      "id": "call-cover",
      "section": "2.2",
      "text": "Cash and deposits at least 1.2 times unfunded commitments.",
      "severity": "breach",
      "test": {
        "figure": "call-cover",
        "is": "gte",
        "limit": 1.2
      }
    },
    {
      "id": "company-cap",
      "section": "3.1",
      "text": "No single company above 10% of net worth, through funds as well.",
      "severity": "breach",
      "test": {
        "figure": "company-share",
        "is": "lte",
        "limit": 10
      }
    },
    {
      "id": "manager-cap",
      "section": "3.2",
      "text": "No single fund manager above 15% of net worth.",
      "severity": "guideline",
      "test": {
        "figure": "manager-share",
        "is": "lte",
        "limit": 15
      }
    },
    {
      "id": "issuer-cap",
      "section": "3.3",
      "text": "No single bond issuer above 7% of net worth; government bonds excepted.",
      "severity": "guideline",
      "test": {
        "figure": "issuer-share",
        "is": "lte",
        "limit": 7
      }
    },
    {
      "id": "ai-cap",
      "section": "3.4",
      "text": "AI and semiconductors exposure under 25%.",
      "severity": "guideline",
      "test": {
        "figure": "ai-share",
        "is": "lt",
        "limit": 25
      }
    },
    {
      "id": "ig-only",
      "section": "4.1",
      "text": "Investment grade only; ratings checked by hand at purchase.",
      "severity": "guideline",
      "test": null
    },
    {
      "id": "ltv",
      "section": "5.1",
      "text": "Loan to value at most 50% on each property.",
      "severity": "breach",
      "test": {
        "figure": "ltv-by-property",
        "is": "lte",
        "limit": 50
      }
    },
    {
      "id": "revalue",
      "section": "5.2",
      "text": "Tell us when a property valuation is over 365 days old.",
      "severity": "watch",
      "test": {
        "figure": "property-valuation-age",
        "is": "lte",
        "limit": 365
      }
    },
    {
      "id": "stale",
      "section": "6.1",
      "text": "Tell the council when a figure behind net worth is older than 120 days.",
      "severity": "watch",
      "test": {
        "figure": "oldest-valuation",
        "is": "lte",
        "limit": 120
      }
    },
    {
      "id": "council-vote",
      "section": "7.1",
      "text": "A new fund manager needs a vote of the council.",
      "severity": "guideline",
      "test": null
    }
