      "view": "tile"
    },
    {
      "id": "company-share",
      "label": "Companies through funds",
      "about": "Each company reached through a fund as a share of net worth (3.1).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "lookthrough",
          "where": [],
          "field": "lt_value"
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value",
          "whole": true
        }
      },
      "view": "table",
      "by": "holding"
    },
    {
      "id": "manager-share",
      "label": "Fund managers",
      "about": "Each manager's funds as a share of net worth (3.2).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "eq",
              "value": "private_fund"
            }
          ],
          "field": "owner_value"
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value",
          "whole": true
        }
      },
      "view": "bars",
      "by": "holding"
    },
    {
      "id": "issuer-share",
      "label": "Bond issuers",
      "about": "Each bond issuer as a share of net worth (3.3).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "eq",
              "value": "bond"
            }
