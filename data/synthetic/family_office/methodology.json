{
  "name": "Family Investment Policy",
  "adopted": "2026-01-10",
  "summary": "A family's wealth across banks, private funds, property and a brokerage account, held inside allocation bands, with liquidity and concentration tested through the funds. The council is told when a valuation goes stale.",
  "source": {
    "title": "Family Investment Policy (fictional)",
    "fileId": null
  },
  "origin": "document",
  "figures": [
    {
      "id": "net-worth",
      "label": "Net worth",
      "about": "Everything at our share, real estate net of mortgages.",
      "unit": "money",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value"
        }
      },
      "view": "tile"
    },
    {
      "id": "public-equity-share",
      "label": "Public equities",
      "about": "Shares and ETFs as a share of net worth (1.1).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "class",
              "is": "eq",
              "value": "public"
            }
          ],
          "field": "owner_value"
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value",
          "whole": true
        }
      },
      "view": "tile"
    },
