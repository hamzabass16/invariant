      "section": "1.3",
      "text": "Fixed income at most 20% of net worth.",
      "severity": "guideline",
      "test": {
        "figure": "fixed-income-share",
        "is": "lte",
        "limit": 20
      }
    },
    {
      "id": "re-cap",
