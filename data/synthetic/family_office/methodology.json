      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "in",
              "value": [
                "cash",
                "deposit"
              ]
            }
          ],
          "field": "owner_value"
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
