  "rules": [
    {
      "id": "equity-low",
      "section": "1.1",
      "text": "Public equities at least 30% of net worth.",
      "severity": "guideline",
      "test": {
        "figure": "public-equity-share",
        "is": "gte",
        "limit": 30
      }
    },
    {
      "id": "equity-high",
      "section": "1.1",
      "text": "Public equities at most 45% of net worth.",
