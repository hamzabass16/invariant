          "whole": true
        }
      },
      "view": "table",
      "by": "holding"
    },
    {
      "id": "ai-share",
      "label": "AI and semiconductors",
      "about": "Direct holdings tagged AI as a share of net worth; the Themes panel adds what funds hold (3.4).",
      "unit": "pct",
      "expr": {
        "op": "ratio",
        "num": {
          "measure": "sum",
          "over": "holdings",
          "where": [
            {
              "field": "themes",
              "is": "contains",
              "value": "AI and semiconductors"
            }
          ],
          "field": "owner_value"
        },
        "den": {
          "measure": "sum",
          "over": "holdings",
          "where": [],
          "field": "owner_value",
          "whole": true
        }
      },
      "view": "tile"
    },
    {
      "id": "ltv-by-property",
      "label": "Loan to value",
      "about": "Mortgage over value, per property (5.1).",
      "unit": "pct",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "avg",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "eq",
              "value": "real_estate"
            }
          ],
          "field": "property_ltv_pct"
        }
      },
      "view": "bars",
      "by": "holding"
    },
    {
      "id": "property-valuation-age",
      "label": "Days since valued",
      "about": "Days since each property's value was set (5.2).",
      "unit": "days",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "avg",
          "over": "holdings",
          "where": [
            {
              "field": "asset_class",
              "is": "eq",
              "value": "real_estate"
            }
          ],
          "field": "age_days"
        }
      },
      "view": "table",
      "by": "holding"
    },
    {
      "id": "oldest-valuation",
      "label": "Oldest valuation",
      "about": "Days since the stalest figure behind net worth was set (6.1).",
      "unit": "days",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "max",
          "over": "holdings",
          "where": [],
          "field": "age_days"
        }
      },
      "view": "tile"
    },
    {
      "id": "distributions-ttm",
      "label": "Distributions, 12 months",
      "about": "Paid back by the funds over the last twelve months (6.2).",
      "unit": "money",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "distribution"
            }
          ],
          "field": "amount",
          "window": {
            "kind": "ttm"
          }
        }
      },
      "view": "tile"
    },
    {
      "id": "calls-ttm",
      "label": "Capital calls, 12 months",
      "about": "Called by the funds over the last twelve months (6.2).",
      "unit": "money",
      "expr": {
        "op": "measure",
        "of": {
          "measure": "sum",
          "over": "transactions",
          "where": [
            {
              "field": "kind",
              "is": "eq",
              "value": "capital_call"
            }
          ],
          "field": "amount",
          "abs": true,
          "window": {
            "kind": "ttm"
          }
        }
      },
      "view": "tile"
    },
    {
      "id": "dpi-by-fund",
      "label": "DPI",
      "about": "Distributions to paid-in, per fund, as reported (6.2).",
