 "classes": [
  {
   "id": "cm",
   "label": "Compounding Machine",
   "about": "No disruption engine (neither company revenue nor a line at least 15% of it grows above 20%) and at least 71% of the measurable thresholds; 10% cap (3.1, C1). An unread threshold leaves the count.",
   "required": [
    {
     "field": "engine_growth_pct",
     "is": "lte",
     "value": 20
    }
   ],
   "criteria": [
    {
     "field": "roic_pct",
     "is": "gte",
     "value": 20,
     "or": [
      {
       "field": "invested_capital",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "operating_margin_pct",
         "is": "gt",
         "value": 0
        }
       ]
      },
      {
       "field": "roic_ex_goodwill_pct",
       "is": "gte",
       "value": 20,
       "given": [
        {
         "field": "goodwill_share_of_capital_pct",
         "is": "gt",
         "value": 50
        }
       ]
      }
     ]
    },
    {
     "field": "gross_margin_pct",
     "is": "gte",
     "value": 40
    },
    {
     "field": "operating_margin_change_pts",
     "is": "gt",
     "value": 0
    },
    {
     "field": "fcf_conversion",
     "is": "gte",
     "value": 0.9,
     "given": [
      {
       "field": "loans_to_equity",
       "is": "lte",
       "value": 1
      }
     ],
     "or": [
      {
       "field": "fcf_conversion_operating",
       "is": "gte",
       "value": 0.9,
       "given": [
        {
         "field": "loans_to_equity",
         "is": "lte",
         "value": 1
        },
        {
         "field": "nonoperating_share_of_net_income_pct",
         "is": "gt",
         "value": 20
        }
       ]
      }
     ]
    },
    {
     "field": "interest_cover",
     "is": "gt",
     "value": 15,
     "or": [
      {
       "field": "net_interest_expense",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "cash_to_debt_pct",
         "is": "gte",
         "value": 75
        }
       ]
      },
      {
       "field": "net_interest_expense",
       "is": "lte",
       "value": 0,
       "given": [
        {
         "field": "net_debt",
         "is": "lte",
         "value": 0
        }
       ]
      },
      {
       "field": "interest_cover_net",
       "is": "gt",
       "value": 15,
       "given": [
        {
         "field": "cash_to_debt_pct",
         "is": "gte",
         "value": 75
        }
       ]
      }
     ]
    },
    {
     "field": "revenue_growth_pct",
     "is": "gt",
     "value": 0
    },
    {
     "field": "fcf_per_share_growth_pct",
     "is": "gt",
     "value": 0
    }
   ],
   "minimumShare": 71
  },
  {
   "id": "tr",
   "label": "Transitional",
   "about": "A disruption engine (company revenue, or a line at least 15% of it, growing above 20%; D.1(a), C3) and at least 57% of the measurable thresholds; 20% cap (3.1, C2). Pathway and triggers in 30 days.",
   "required": [
    {
     "field": "engine_growth_pct",
     "is": "gt",
     "value": 20
    }
   ],
   "criteria": [
    {
     "field": "roic_pct",
     "is": "gte",
     "value": 20,
