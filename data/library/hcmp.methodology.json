   "expr": {
    "op": "measure",
    "of": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": []
    }
   },
   "view": "tile"
  },
  {
   "id": "cash-weight",
   "label": "Cash",
   "about": "Cash as a share of net liquidation.",
   "unit": "pct",
   "expr": {
    "op": "ratio",
    "num": {
     "measure": "sum",
     "over": "holdings",
     "field": "owner_value",
     "where": [
      {
       "field": "asset_class",
       "is": "eq",
       "value": "cash"
      }
     ]
