        "is": "gte",
        "limit": 10
      }
    },
    {
      "id": "g-max-holdings",
      "section": "Ch. 5",
      "text": "Hold no more than about thirty stocks.",
      "severity": "guideline",
      "test": {
        "figure": "positions",
        "is": "lte",
        "limit": 30
      }
    },
    {
      "id": "g-cap",
      "section": "Ch. 5",
      "text": "No single defensive stock above 10% of the portfolio.",
      "severity": "breach",
      "test": {
        "figure": "weight-defensive",
        "is": "lte",
        "limit": 10
      }
    },
    {
      "id": "g-bonds",
