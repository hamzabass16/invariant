  "classes": [
    {
      "id": "fast",
      "label": "Fast grower",
      "about": "Earnings growing 20% a year or more, a P/E no higher than about 25 and little debt.",
      "required": [
        {
          "field": "eps_growth_pct",
          "is": "gte",
          "value": 20
        }
      ],
      "criteria": [
        {
          "field": "pe_ratio",
          "is": "lte",
          "value": 25
        },
        {
          "field": "net_debt_to_ebitda",
          "is": "lte",
          "value": 2
        },
        {
          "field": "revenue_growth_pct",
          "is": "gte",
          "value": 15
        }
      ],
      "minimum": 2
    },
    {
      "id": "stalwart",
      "label": "Stalwart",
      "about": "Earnings growing 10% to 20% a year at a P/E no higher than about 20.",
      "required": [
        {
          "field": "eps_growth_pct",
          "is": "gte",
          "value": 10
        }
      ],
      "criteria": [
        {
          "field": "pe_ratio",
          "is": "lte",
          "value": 20
        },
        {
          "field": "net_debt_to_ebitda",
          "is": "lte",
          "value": 3
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "pl-fast-cap",
