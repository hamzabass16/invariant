# Invariant: every setting the app reads.
#
# Copy this file to .env.local for development. For a deployment, set the
# same names in Vercel, Project, Settings, Environment Variables. Never commit
# a value and never paste one into a chat.
#
# The groups below go from what every deployment needs to what only some do.
# Leave a value empty to switch its feature off: the app says so on the
# screen that needs it, never fails quietly.

# ── 1. Required ──────────────────────────────────────────────────────────────

# Where each person's data lives:
#   demo   fictional samples, the visitor's choices kept in a cookie (default)
#   drive  each person's own vault: a "Portfolio OS" folder in their Google
#          Drive (drive.file scope only), the Apps/Portfolio OS folder in
#          their OneDrive, or a bucket of their own they paste on Setup
STORAGE="demo"

# Any strong random value, for the session cookie and the connector's tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Demo only: open the demo with no sign-in, for a public showcase.
# Ignored when STORAGE=drive.
DEMO_PUBLIC=""

# ── 2. Sign-in (STORAGE=drive) ───────────────────────────────────────────────

# Google Cloud, APIs & Services, Credentials, OAuth 2.0 Client ID (Web).
# Authorised redirect URIs:
#   https://<your-domain>/api/auth/callback/google
#   https://<your-domain>/api/vault/google/callback
#   and the same two on http://localhost:3000 for development.
# Enable the Google Drive API and add the drive.file scope to the consent
# screen. Publish the consent screen: in Testing, Google ends Drive access
# every 7 days.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: Microsoft sign-in, for people whose files live in OneDrive.
# Microsoft Entra, App registrations, New: "Accounts in any organizational
# directory and personal Microsoft accounts"; redirect URI (Web)
# https://<your-domain>/api/auth/callback/microsoft-entra-id; delegated Graph
# permissions openid, email, profile, offline_access, User.Read,
# Files.ReadWrite.AppFolder; then a client secret.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Comma-separated addresses allowed to sign in with Google or Microsoft
# without an account. For a personal deployment, put your own address here.
ALLOWED_EMAILS=""

# Who may make an account (needs DATABASE_URL):
#   open    anyone
#   invite  only with an invitation made on /ops
#   empty   nobody but ALLOWED_EMAILS
SIGN_UP=""

# The addresses that may open /ops (the jobs, the AI spend, invitations).
OPERATOR_EMAILS=""

# Local only: Auth.js refuses an untrusted host outside Vercel.
AUTH_TRUST_HOST="true"

# Local preview and smoke runs only: skips sign-in as this address.
# Refuses to run on Vercel. Never set it there.
PREVIEW_OPERATOR_EMAIL=""

# ── 3. The database ──────────────────────────────────────────────────────────

# Postgres (Neon's free tier is enough for one person or a small group;
# Neon, your project, Connect, the pooled connection string). It holds the
# registry: accounts, report schedules, the scheduled-job queue, each
# month's AI spend per person and the public company figures shared by
# everyone. Never anyone's portfolio figures, which stay in their vault.
DATABASE_URL=""

# 32 random bytes, base64, to encrypt the refresh tokens and credentials the
# registry keeps:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REPORT_KEY=""
# Optional: the key before the last rotation, so values sealed with it still open.
REPORT_KEY_PREVIOUS=""

# ── 4. AI (your own Anthropic key) ───────────────────────────────────────────

# Every model call runs on Claude under this one key (read in
# lib/hosted-model.ts alone). Each person's month is metered and capped.
# Without a key the app runs with no AI: figures, checks and alerts never
# need it. Make one at https://console.anthropic.com.
ANTHROPIC_API_KEY=""
# US dollars of AI a month per person, at list price (15 when unset).
MODEL_CAP_USD=""
# Optional caps per plan, as "plan:dollars" pairs, e.g. "beta:3,core:1.5,pro:6",
# and the plan a new account takes. A plan here is only an AI allowance.
PLAN_CAPS_USD=""
DEFAULT_PLAN=""

# Optional: pin a model for one job instead of the newest of its tier.
ANTHROPIC_MODEL=""
ANTHROPIC_ANALYST_MODEL=""
ANTHROPIC_CALENDAR_MODEL=""
ANTHROPIC_CREED_MODEL=""
ANTHROPIC_DATA_MODEL=""
ANTHROPIC_ECO_MODEL=""
ANTHROPIC_HUNTER_MODEL=""
ANTHROPIC_MACRO_MODEL=""
ANTHROPIC_NEWSLETTER_MODEL=""
ANTHROPIC_PROSE_MODEL=""
ANTHROPIC_RECAP_MODEL=""
ANTHROPIC_RESEARCH_MODEL=""
ANTHROPIC_STATEMENT_MODEL=""
ANTHROPIC_WATCH_MODEL=""

# Local only, for the synthetic loop (npm run synth:loop), never in Vercel:
# an open model to score against Claude on the same fictional personas.
MODEL_PROVIDER=""
MODEL_BASE_URL=""
MODEL_NAME=""
MODEL_API_KEY=""

# ── 5. Scheduled runs ────────────────────────────────────────────────────────

# Vercel sends this with each cron call in vercel.json. Any strong random
# value. Unset, the cron routes accept nothing and nothing runs by itself.
CRON_SECRET=""
# The deployment's own address for links in emails (default: the production
# address Vercel gives the project).
APP_URL=""

# ── 6. Mail: reports, alerts and sign-up codes ───────────────────────────────

# The SMTP account the app sends from, only ever to a person's own sign-in
# address. Gmail: smtp.gmail.com, 465, the address and an app password.
MAIL_HOST=""
MAIL_PORT="465"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM=""

# The inbox statements and newsletters are forwarded to, read by IMAP,
# read-only. Use a mailbox made for this alone. Each person gets a tagged
# address (name+tag@domain). Another provider than Gmail needs its IMAP host
# and port, and must write Authentication-Results lines.
INBOX_ADDRESS=""
INBOX_PASSWORD=""
INBOX_IMAP_HOST=""
INBOX_IMAP_PORT=""

# Optional: addresses that get the shared daily recap the inbox itself is
# subscribed to. Each person's own subscription works without it.
SHARED_RECAP_TO=""

# ── 7. Push notifications ────────────────────────────────────────────────────

# One notification after each US close. Make the pair once with
#   npx web-push generate-vapid-keys
# and keep it: a new pair turns off every device already on.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Optional: mailto: or https contact for the push services.
VAPID_SUBJECT=""

# ── 8. Public data ───────────────────────────────────────────────────────────

# "licensed" reads only the sources whose terms let an app run for others
# show them (SEC, US government series, the ECB, the OECD and the rest in
# lib/licences.ts). Set it on any deployment other people sign in to. Unset,
# every source is read, which suits a deployment only you use; see
# "Data sources" in the README.
SOURCES=""

# The contact the SEC asks every automated client to send (a name and an
# address), for the reads made for everyone. Default: INBOX_ADDRESS.
SEC_CONTACT=""

# ── 9. What the deployment says about itself ─────────────────────────────────

# The address the privacy, terms, cookies and help pages give
# (default INBOX_ADDRESS).
CONTACT_EMAIL=""
# The public demo the sign-in page links, such as https://your-demo.vercel.app.
DEMO_URL=""
# The source code the front page links, such as the repository on GitHub.
SOURCE_URL=""
# Optional: Google Search Console's verification code, for publishing the
# Google consent screen.
GOOGLE_SITE_VERIFICATION=""

# ── 10. Operator extras (optional) ───────────────────────────────────────────

# /ops can merge or close the weekly self-fix pull requests (docs/SELF_FIX.md).
OPS_GITHUB_TOKEN=""
OPS_GITHUB_REPO=""
# /ops draws the database's month from Neon's API.
NEON_API_KEY=""
NEON_PROJECT_ID=""
